{
  "name": "artisys-oficina",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node --watch src/start.js",
    "start": "node src/start.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test tests/e2e.test.js tests/jornada-cliente-os.e2e.test.js tests/jornada-resiliencia.e2e.test.js",
    "lint": "node scripts/lint.mjs",
    "build": "node scripts/build.mjs",
    "ci": "npm run lint && npm test && npm run build && npm run test:e2e",
    "db:migrate": "node src/migrate-assistencia.js",
    "db:seed": "node src/seed-assistencia.js",
    "desktop:dist": "powershell -ExecutionPolicy Bypass -File scripts/build-electron.ps1",
    "db:benchmark": "node scripts/benchmark-db.mjs",
    "db:health": "node scripts/db-health.mjs",
    "start:multi": "node src/start-multitenant.js",
    "dev:multi": "node --watch src/start-multitenant.js",
    "start:postgres-core": "node src/start-postgres-core.js"
  }
}

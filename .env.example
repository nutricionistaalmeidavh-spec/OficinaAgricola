PORT=3344
HOST=127.0.0.1
# Deixe vazios para criar banco e anexos exclusivos da nova ArtiSys Oficina.
DATABASE_PATH=
STORAGE_DIR=
EVENT_LOG_PATH=./data/oficina-events.jsonl
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
NODE_ENV=development

# Acesso LAN: configure HTTPS_CERT_FILE e HTTPS_KEY_FILE e HOST=0.0.0.0 explicitamente.
# Nunca exponha a porta HTTP em redes externas.
# HTTPS_CERT_FILE=/caminho/certificado.pem
# HTTPS_KEY_FILE=/caminho/chave.pem
# BACKUP_ROOT=/caminho/backups
# BACKUP_RETENTION=7

# Opcional. Emissor fiscal REAL instalado e homologado no mesmo computador.
# Não habilitar sem credenciamento, certificado e revisão tributária. Nunca exigir SaaS pago.
# FISCAL_LOCAL_PROVIDER_URL=http://127.0.0.1:3499

# ACBrLib local: configurações OPCIONAIS. Sem ACBr, o fiscal fica desligado.
# Para habilitar, use caminhos absolutos com DLL/SO compilada dos fontes livres ACBr.
# Nunca incluir certificado/senha aqui nem no código-fonte.
# FISCAL_ACBR_NFE_LIB=C:\\ACBrLib\\ACBrNFe64.dll
# FISCAL_ACBR_NFE_CONFIG=C:\\FiscalPrivado\\ACBrLibNFe.ini
# FISCAL_ACBR_NFSE_LIB=C:\\ACBrLib\\ACBrNFSe64.dll
# FISCAL_ACBR_NFSE_CONFIG=C:\\FiscalPrivado\\ACBrLibNFSe.ini
# FISCAL_ACBR_INPUT_DIR=C:\\FiscalPrivado\\Entrada
# FISCAL_ACBR_PYTHON=python
# Nunca configurar ACBrLib e FISCAL_LOCAL_PROVIDER_URL ao mesmo tempo.

# Modo multiempresa: iniciar com npm run start:multi (opcional, R$ 0).
# TENANCY_REGISTRY_PATH=/srv/oficina/data/oficina-registry.sqlite
# TENANCY_DATA_ROOT=/srv/oficina/data/oficina-tenants
# Se e somente se houver reverse proxy HTTPS no MESMO host (loopback):
# TRUST_LOOPBACK_PROXY=1
# PostgreSQL, D1 e R2 ainda nao sao motores primarios disponiveis neste runtime.

# Opcional: replica de backups ja verificados para MinIO self-hosted ou R2.
# Sem estas opcoes, o backup e mantido no disco local (core R$ 0).
# Configure credenciais SOMENTE nas variaveis privadas do servidor, nunca no Git.
# OFICINA_BACKUP_S3_ENDPOINT=https://minio.exemplo.com
# OFICINA_BACKUP_S3_BUCKET=oficina-backups
# OFICINA_BACKUP_S3_REGION=us-east-1
# OFICINA_BACKUP_S3_PREFIX=artisys-oficina
# OFICINA_BACKUP_S3_ACCESS_KEY_ID=<definir-em-ambiente-privado>
# OFICINA_BACKUP_S3_SECRET_ACCESS_KEY=<definir-em-ambiente-privado>
# Para teste local MinIO, http://127.0.0.1:9000 e permitido; remoto requer HTTPS.

# Arquivos de emissor fiscal por empresa fora do Git (opcional).
# O arquivo JSON mapeia IDs de empresas a CNPJ e configuração ACBr/sidecar.
# TENANCY_FISCAL_CONFIG_FILE=/srv/oficina/private/tenant-fiscal.json

# Storage principal de anexos: DISCO por padrão (R$ 0, self-hosted).
# MinIO self-hosted e Cloudflare R2 por API S3 são opções explícitas.
# OFICINA_DATABASE_ENGINE=sqlite
# OFICINA_OBJECT_STORAGE=s3
# OFICINA_ATTACHMENT_S3_ENDPOINT=https://minio.exemplo.com
# OFICINA_ATTACHMENT_S3_BUCKET=oficina-anexos
# OFICINA_ATTACHMENT_S3_REGION=us-east-1
# OFICINA_ATTACHMENT_S3_PREFIX=oficina-attachments
# OFICINA_ATTACHMENT_S3_ACCESS_KEY_ID=<configurar-em-ambiente-privado>
# OFICINA_ATTACHMENT_S3_SECRET_ACCESS_KEY=<configurar-em-ambiente-privado>
# Os emissores D1/PostgreSQL ainda exigem migração async completa do domínio.

# Exemplo EXCLUSIVO para desenvolvimento/self-hosted PostgreSQL.
# O instalador Windows configura PostgreSQL 16 e ACBr automaticamente.
# NÃO é necessário criar .env nem usar terminal no computador do cliente.
#
# Forneça URLs reais por variáveis de ambiente PRIVADAS do servidor.
# Não comitar credenciais ou chaves. Valores abaixo são placeholders.
PORT=3344
HOST=127.0.0.1
OFICINA_POSTGRES_PORT=3344
OFICINA_POSTGRES_REGISTRY_URL=postgresql://USUARIO:SENHA_LOCAL@127.0.0.1:5432/oficina_registry
OFICINA_POSTGRES_OPERATIONS_URL=postgresql://USUARIO:SENHA_LOCAL@127.0.0.1:5432/oficina_operations
OFICINA_POSTGRES_STORAGE_ROOT=./storage/postgres
OFICINA_POSTGRES_SCHEMA_PREFIX=oficina
OFICINA_POSTGRES_PROVISION_NEW_UNITS=true

# Apenas para criar registry novo e vazio em desenvolvimento:
# OFICINA_REGISTRY_NEW_INSTALL=true
# Após bootstrap inicial, remover a variável. Não usar com dados existentes.
#
# O desktop Windows gerencia automaticamente suas URLs privadas,
# provisionamento inicial, cluster, senhas, instalações e reinícios.
# Sem SQLite, fallback, serviço pago ou migração de usuários anteriores.

# Fiscal opcional. O instalador Windows já inclui ACBr open source.
# Nunca incluir senhas fiscais ou certificado privado neste arquivo.
# FISCAL_LOCAL_PROVIDER_URL=http://127.0.0.1:3499
# FISCAL_ACBR_NFE_LIB=C:\\FiscalPrivado\\ACBrNFe64.dll
# FISCAL_ACBR_NFSE_LIB=C:\\FiscalPrivado\\ACBrNFSe64.dll
# FISCAL_ACBR_NFE_CONFIG=C:\\FiscalPrivado\\ACBrLibNFe.ini
# FISCAL_ACBR_NFSE_CONFIG=C:\\FiscalPrivado\\ACBrLibNFSe.ini

# Anexos: disco local por padrão, R$ 0. MinIO é integração opcional.
# Nenhum S3, R2, D1, serviço de nuvem ou SaaS é dependência obrigatória.

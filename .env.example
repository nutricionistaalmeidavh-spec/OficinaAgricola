PORT=3344
HOST=127.0.0.1
# Deixe vazios para criar banco e anexos exclusivos da nova ArtiSys Oficina.
DATABASE_PATH=
STORAGE_DIR=
EVENT_LOG_PATH=./data/oficina-events.jsonl
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
NODE_ENV=development

# Acesso LAN: configure HTTPS_CERT_FILE e HTTPS_KEY_FILE e HOST=0.0.0.0 explicitamente.
# Nunca exponha a porta HTTP em redes externas.
# HTTPS_CERT_FILE=/caminho/certificado.pem
# HTTPS_KEY_FILE=/caminho/chave.pem
# BACKUP_ROOT=/caminho/backups
# BACKUP_RETENTION=7

# Opcional. Emissor fiscal REAL instalado e homologado no mesmo computador.
# Não habilitar sem credenciamento, certificado e revisão tributária. Nunca exigir SaaS pago.
# FISCAL_LOCAL_PROVIDER_URL=http://127.0.0.1:3499

# ACBrLib local: configurações OPCIONAIS. Sem ACBr, o fiscal fica desligado.
# Para habilitar, use caminhos absolutos com DLL/SO compilada dos fontes livres ACBr.
# Nunca incluir certificado/senha aqui nem no código-fonte.
# FISCAL_ACBR_NFE_LIB=C:\\ACBrLib\\ACBrNFe64.dll
# FISCAL_ACBR_NFE_CONFIG=C:\\FiscalPrivado\\ACBrLibNFe.ini
# FISCAL_ACBR_NFSE_LIB=C:\\ACBrLib\\ACBrNFSe64.dll
# FISCAL_ACBR_NFSE_CONFIG=C:\\FiscalPrivado\\ACBrLibNFSe.ini
# FISCAL_ACBR_INPUT_DIR=C:\\FiscalPrivado\\Entrada
# FISCAL_ACBR_PYTHON=python
# Nunca configurar ACBrLib e FISCAL_LOCAL_PROVIDER_URL ao mesmo tempo.

PORT=3344
HOST=127.0.0.1
# Deixe vazios para criar banco e anexos exclusivos da nova ArtiSys Oficina.
DATABASE_PATH=
STORAGE_DIR=
EVENT_LOG_PATH=./data/oficina-events.jsonl
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
NODE_ENV=development

# Acesso LAN: configure HTTPS_CERT_FILE e HTTPS_KEY_FILE e HOST=0.0.0.0 explicitamente.
# Nunca exponha a porta HTTP em redes externas.
# HTTPS_CERT_FILE=/caminho/certificado.pem
# HTTPS_KEY_FILE=/caminho/chave.pem
# BACKUP_ROOT=/caminho/backups
# BACKUP_RETENTION=7

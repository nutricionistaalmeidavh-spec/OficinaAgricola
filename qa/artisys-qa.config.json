{
  "schemaVersion": 1,
  "systemId": "artisys-oficina",
  "mode": "web",
  "defaultEnvironment": "local",
  "defaultFlow": "stage7-shell",
  "defaultViewport": "desktop",
  "capture": {
    "video": true,
    "screenshotEachStep": true,
    "fps": 4
  },
  "environments": {
    "local": {
      "baseURL": "http://127.0.0.1:3344",
      "startCommand": "cd .. && rm -rf .qa && node scripts/seed-qa-demo.mjs && npm start",
      "readyUrl": "http://127.0.0.1:3344/api/health",
      "readyTimeoutMs": 30000,
      "env": {
        "HOST": "127.0.0.1",
        "PORT": "3344",
        "DATABASE_PATH": ".qa/artisys-oficina.sqlite",
        "STORAGE_DIR": ".qa/uploads",
        "EVENT_LOG_PATH": ".qa/events.jsonl"
      }
    }
  },
  "flows": {
    "stage7-shell": "flows/stage7-shell.json",
    "stage7-dashboard": "flows/stage7-dashboard.json"
  }
}
